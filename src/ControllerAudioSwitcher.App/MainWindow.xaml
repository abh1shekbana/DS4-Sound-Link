<Window x:Class="ControllerAudioSwitcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DualShock 4 Bluetooth Audio Streamer" 
        Height="720" Width="960" 
        MinHeight="600" MinWidth="800"
        Background="#0F1117"
        Foreground="#E2E8F0"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Modern ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1A1D27"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Card Container Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#161922"/>
            <Setter Property="BorderBrush" Value="#232736"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Metric Label Style -->
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>

        <!-- Metric Value Style -->
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top App Header -->
            <RowDefinition Height="*"/>    <!-- Main Dashboard -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP APP HEADER -->
        <Border Grid.Row="0" Background="#131620" BorderBrush="#1E2330" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="8" Width="36" Height="36" Margin="0,0,14,0">
                        <TextBlock Text="🎧" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DualShock 4 Bluetooth Audio Streamer" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0.0 (Windows 11)" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Stream PC audio to controller 3.5 mm headphone jack over wireless Bluetooth" 
                                   FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusBadgeBorder" Background="#27272A" CornerRadius="14" Padding="12,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusIndicatorDot" Width="8" Height="8" Fill="#71717A" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusBadgeText" Text="Disconnected" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnMinimizeToTray" Content="Minimize to Tray" Click="OnMinimizeToTrayClicked" 
                            Background="#1E2330" Foreground="#94A3B8" BorderBrush="#2D3344" BorderThickness="1" 
                            Padding="10,5" FontSize="11" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN DASHBOARD CONTENT -->
        <Grid Grid.Row="1" Margin="20,16,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Controller & Streaming Controls -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <!-- CARD 1: CONTROLLER STATUS -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="CONTROLLER HARDWARE" Style="{StaticResource SectionTitle}"/>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Detected Controller:" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="TxtControllerName" Grid.Column="1" Text="No DualShock 4 connected" Style="{StaticResource MetricValue}"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Connection Interface:" Style="{StaticResource MetricLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock x:Name="TxtConnectionType" Text="None" Style="{StaticResource MetricValue}"/>
                                    <TextBlock x:Name="TxtInterfaceHint" Text="" FontSize="11" Foreground="#94A3B8" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Audio Capability:" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="TxtAudioCapability" Grid.Column="1" Text="Unknown" Style="{StaticResource MetricValue}"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Hardware ID / Path:" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="TxtDevicePath" Grid.Column="1" Text="-" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: AUDIO STREAMING CONTROLS -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="STREAMING CONTROLS" Style="{StaticResource SectionTitle}"/>

                            <!-- Big Action Buttons -->
                            <Grid Margin="0,4,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnStartStreaming" Grid.Column="0" Content="▶  Start Streaming" Click="OnStartStreamingClicked"
                                        Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" 
                                        BorderThickness="0" Height="42" Margin="0,0,6,0" Cursor="Hand" IsEnabled="False">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <Button x:Name="BtnStopStreaming" Grid.Column="1" Content="⏹  Stop Streaming" Click="OnStopStreamingClicked"
                                        Background="#1E2330" Foreground="#F87171" FontWeight="SemiBold" FontSize="13" 
                                        BorderBrush="#374151" BorderThickness="1" Height="42" Margin="6,0,0,0" Cursor="Hand" IsEnabled="False">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <!-- Audio Output Source Selection -->
                            <TextBlock Text="Windows Playback Audio Source:" Style="{StaticResource MetricLabel}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbAudioDevices" Grid.Column="0" Height="34" Background="#11131A" Foreground="#E2E8F0"
                                          BorderBrush="#232736" SelectionChanged="OnAudioDeviceSelectionChanged"/>
                                <Button Grid.Column="1" Content="↻" Click="OnRefreshDevicesClicked" Width="34" Height="34" 
                                        Margin="8,0,0,0" Background="#1E2330" Foreground="#94A3B8" BorderBrush="#2D3344" Cursor="Hand" ToolTip="Refresh Audio Devices">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <!-- Audio Isolation Action Buttons -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnToggleSpeakerMute" Grid.Column="0" Content="🔇 Mute PC Speakers" Click="OnToggleSpeakerMuteClicked"
                                        Height="30" Margin="0,0,4,0" Background="#1E2330" Foreground="#F59E0B" BorderBrush="#374151" BorderThickness="1" 
                                        FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button x:Name="BtnOpenSoundSettings" Grid.Column="1" Content="⚙ Windows Sound Settings" Click="OnOpenSoundSettingsClicked"
                                        Height="30" Margin="4,0,0,0" Background="#1E2330" Foreground="#94A3B8" BorderBrush="#374151" BorderThickness="1" 
                                        FontSize="11" Cursor="Hand" ToolTip="Open Windows 11 sound output device settings">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <!-- Volume Slider -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="3.5 mm Headphone Jack Volume:" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="TxtVolumeValue" Grid.Column="1" Text="86% (110/127)" Style="{StaticResource MetricValue}"/>
                            </Grid>
                            <Slider x:Name="SliderVolume" Minimum="0" Maximum="127" Value="110" TickFrequency="1" 
                                    IsSnapToTickEnabled="True" Margin="0,4,0,16" ValueChanged="OnVolumeChanged"/>

                            <!-- Options Checkboxes -->
                            <CheckBox x:Name="ChkMuteSpeakers" Content="Mute PC Speakers during streaming (Headphone Isolation)" 
                                      Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,8" IsChecked="True"
                                      Checked="OnSettingsOptionChanged" Unchecked="OnSettingsOptionChanged"/>
                            <CheckBox x:Name="ChkAutoStart" Content="Automatically stream when compatible DualShock 4 connects" 
                                      Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,8" Checked="OnSettingsOptionChanged" Unchecked="OnSettingsOptionChanged"/>
                            <CheckBox x:Name="ChkDiagnosticCaptureOnly" Content="Diagnostic Capture Test Mode (WASAPI loopback test without transmission)" 
                                      Foreground="#94A3B8" FontSize="11" Margin="0,0,0,8" Checked="OnDiagnosticCaptureModeChanged" Unchecked="OnDiagnosticCaptureModeChanged"/>
                            <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to System Tray when window is closed" 
                                      Foreground="#CBD5E1" FontSize="12" Checked="OnSettingsOptionChanged" Unchecked="OnSettingsOptionChanged"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: Telemetry & Logs -->
            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- CARD 3: STREAM TELEMETRY -->
                <Border Grid.Row="0" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="AUDIO PIPELINE &amp; METRICS" Style="{StaticResource SectionTitle}"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Codec Pipeline:" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="SBC Stereo (32 kHz, Bitpool 48)" Style="{StaticResource MetricValue}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Report Cadence:" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="HID 0x17 (4 frames = 16 ms)" Style="{StaticResource MetricValue}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Packets Streamed:" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="TxtPacketsSent" Text="0 packets (0 KB)" Style="{StaticResource MetricValue}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Estimated Latency:" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="TxtEstimatedLatency" Text="Idle" Style="{StaticResource MetricValue}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Buffer Health:" Style="{StaticResource MetricLabel}"/>
                            <ProgressBar x:Name="PbBufferLevel" Grid.Column="1" Height="8" Minimum="0" Maximum="64" Value="0" 
                                         Background="#11131A" Foreground="#3B82F6" BorderThickness="0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Buffer Underruns:" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="TxtUnderruns" Text="0" Style="{StaticResource MetricValue}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 4: DIAGNOSTIC LOGS -->
                <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="DIAGNOSTIC LOGS" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy" Click="OnCopyLogsClicked" Background="#1E2330" Foreground="#94A3B8" 
                                        BorderBrush="#2D3344" BorderThickness="1" Padding="8,2" FontSize="10" Margin="0,0,6,0" Cursor="Hand"/>
                                <Button Content="Clear" Click="OnClearLogsClicked" Background="#1E2330" Foreground="#94A3B8" 
                                        BorderBrush="#2D3344" BorderThickness="1" Padding="8,2" FontSize="10" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <TextBox x:Name="TxtLogConsole" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                                 HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" 
                                 Background="#0D0F15" Foreground="#A0AEC0" BorderBrush="#1E2330" BorderThickness="1" 
                                 Padding="8" TextWrapping="NoWrap"/>

                        <TextBlock Grid.Row="2" Text="* Logs include connection lifecycle, HID transport, and audio capture diagnostics." 
                                   FontSize="10" Foreground="#475569" Margin="0,6,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#0B0D12" BorderBrush="#1E2330" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusMessage" Text="Application ready. Waiting for DualShock 4 connection..." 
                           FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="Bluetooth HID 0x17 Overlapped Transport" 
                           FontSize="10" Foreground="#475569"/>
            </Grid>
        </Border>
    </Grid>
</Window>
