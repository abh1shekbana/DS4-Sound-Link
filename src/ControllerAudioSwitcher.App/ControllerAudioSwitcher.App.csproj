<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ControllerAudioSwitcher.Core\ControllerAudioSwitcher.Core.csproj" />
    <ProjectReference Include="..\ControllerAudioSwitcher.Audio\ControllerAudioSwitcher.Audio.csproj" />
    <ProjectReference Include="..\ControllerAudioSwitcher.Transport\ControllerAudioSwitcher.Transport.csproj" />
    <ProjectReference Include="..\ControllerAudioSwitcher.Controller\ControllerAudioSwitcher.Controller.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>DS4SoundLink</AssemblyName>
    <Product>DS4-SoundLink</Product>
    <Title>DS4-SoundLink</Title>
    <Description>DualShock 4 Bluetooth Audio Streamer for Windows 11</Description>
    <Company>DS4SoundLink</Company>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" Condition="Exists('app.ico')" />
    <None Update="app.ico" Condition="Exists('app.ico')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
